{
  "name": "@dsh-external/dsh-subagent-router",
  "version": "0.0.2",
  "description": "Subagent routing console: sidebar panel to pick subagent model & reasoning effort with presets, per-channel rules, live child monitor, and a conversational subagent_route tool",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "BSD-3-Clause",
  "author": "heyuhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyuhang908/dsh-subagent-router.git"
  },
  "homepage": "https://github.com/heyuhang908/dsh-subagent-router#readme",
  "bugs": {
    "url": "https://github.com/heyuhang908/dsh-subagent-router/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subagent",
    "model-routing",
    "reasoning-effort",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
